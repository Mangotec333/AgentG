# ============================================
# AI Workflow Shield (AgentG) - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# cp env.template .env
# ============================================

# ============================================
# LLM API KEYS (Required for Threat Engine & RCA)
# ============================================
# Get your Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get your OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Guardian Agent Configuration
# ============================================
SHIELD_AGENT_ID=your_agent_id_here
SHIELD_WORKSPACE_ID=your_workspace_id_here
SHIELD_API_KEY=your_shield_api_key_here
SHIELD_INGESTION_ENDPOINT=https://shield.mangotec.ai/api/v1/ingest

# Optional: Batch settings
# SHIELD_BATCH_SIZE=50
# SHIELD_BATCH_INTERVAL=30
# SHIELD_MAX_QUEUE=1000

# ============================================
# Backend Configuration
# ============================================
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/shield_db

# Secret key for JWT/session tokens (generate a random string)
SECRET_KEY=your_secret_key_here

# Optional: Redis for queuing (if using Redis)
# REDIS_URL=redis://localhost:6379/0

# ============================================
# Notes:
# ============================================
# 1. GEMINI_API_KEY and OPENAI_API_KEY are used by:
#    - backend/threat_engine/models/llm_analyzer.py (threat detection)
#    - incident/rca_generator.py (RCA generation)
#
# 2. SHIELD_API_KEY is used for:
#    - Guardian Agent → Ingestion API authentication
#    - Workspace isolation
#
# 3. DATABASE_URL format:
#    postgresql://[user]:[password]@[host]:[port]/[database]
#
# 4. SECRET_KEY should be a long random string (use: openssl rand -hex 32)

