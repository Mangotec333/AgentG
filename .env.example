# AI Workflow Shield - Environment Configuration

# Guardian Agent Configuration
SHIELD_AGENT_ID=default_agent
SHIELD_WORKSPACE_ID=default_workspace
SHIELD_API_KEY=your_api_key_here
SHIELD_INGESTION_ENDPOINT=https://shield.mangotec.ai/api/v1/ingest
SHIELD_BATCH_SIZE=50
SHIELD_BATCH_INTERVAL=30
SHIELD_MAX_QUEUE=1000

# Backend Configuration
DATABASE_URL=postgresql://user:password@localhost/shield_db
SECRET_KEY=change-me-in-production
SHIELD_API_KEY=your_api_key_here

# LLM API Keys (Optional)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Redis (Optional, for queue)
REDIS_URL=redis://localhost:6379
